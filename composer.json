{
    "name": "tomvondracek/bolt-altcha",
    "description": "Bolt CMS extension that protects forms from bots with ALTCHA, a self-hosted proof-of-work challenge: Bolt's login and password reset by configuration, any Symfony or hand-written form with the library's own options. No third-party requests, no cookies.",
    "type": "bolt-extension",
    "license": "MIT",
    "keywords": [
        "bolt",
        "bolt-extension",
        "altcha",
        "captcha",
        "proof-of-work",
        "spam",
        "bot-protection",
        "forms",
        "security"
    ],
    "authors": [
        {
            "name": "Tomáš Vondráček",
            "email": "tomasvondrac@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "altcha-org/altcha": "^2.4",
        "psr/cache": "^1.0 || ^2.0 || ^3.0",
        "psr/clock": "^1.0",
        "psr/log": "^1.0 || ^2.0 || ^3.0.2",
        "symfony/cache": "^6.4.50 || ^7.0",
        "symfony/dependency-injection": "^6.4.49 || ^7.0",
        "symfony/event-dispatcher": "^6.4.44 || ^7.0",
        "symfony/filesystem": "^6.4 || ^7.4.23",
        "symfony/form": "^6.4.50 || ^7.0",
        "symfony/http-foundation": "^6.4 || ^7.4.23",
        "symfony/http-kernel": "^6.4.50 || ^7.0",
        "symfony/lock": "^6.4 || ^7.4.23",
        "symfony/options-resolver": "^6.4 || ^7.4.22",
        "symfony/rate-limiter": "^6.4.50 || ^7.0",
        "symfony/routing": "^6.4 || ^7.4.23",
        "symfony/security-core": "^6.4 || ^7.4.23",
        "symfony/security-http": "^6.4 || ^7.4.23",
        "symfony/translation-contracts": "^2.5 || ^3.8.1",
        "symfony/yaml": "^6.4.50 || ^7.0",
        "twig/twig": "^3.30",
        "symfony/polyfill-php84": "^1.43"
    },
    "require-dev": {
        "bolt/core": "^6.1.10",
        "phpstan/extension-installer": "1.4.3",
        "phpstan/phpstan": "2.3.7",
        "phpstan/phpstan-deprecation-rules": "2.0.5",
        "phpstan/phpstan-phpunit": "2.1.2",
        "phpstan/phpstan-strict-rules": "2.1.1",
        "phpunit/phpunit": "^11.5.58",
        "rector/rector": "2.8.5",
        "symplify/easy-coding-standard": "^13.3.23"
    },
    "conflict": {
        "bolt/core": "<6.0 || >=7.0"
    },
    "autoload": {
        "psr-4": {
            "Tomvondracek\\Altcha\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tomvondracek\\Altcha\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        },
        "entrypoint": "Tomvondracek\\Altcha\\Extension"
    },
    "config": {
        "allow-plugins": {
            "symfony/flex": false,
            "drupol/composer-packages": false,
            "phpstan/extension-installer": true,
            "symfony/runtime": true
        }
    }
}
